# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
/db
/out-tsc
# Only exists if Bazel was run
/bazel-out

# dependencies
/node_modules

# ai
/.claude

# internal work docs (plans, notes, drafts)
/docs

# staging folder for files pending manual deletion
/_to_delete

# local commit helper (session-generated, not part of the platform)
/scripts/commit.bat

# AI session artifact - a copy of the project instructions, regenerated per
# session. Not part of the platform.
/AGENTS.md

# Local backups of letter templates, kept beside the original while a new
# version from the client is being verified. Prefixed with an underscore.
src/assets/letters/**/_*.docx

# Word temp/lock files
~$*

# profiling files
chrome-profiler-events*.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# misc
/.angular/cache
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.env
.vscode/settings.json

/meeting

# כלי בדיקה מקומיים וגיבויי קבצים - לא נכנסים למקור
tools/_chk/
*.bak
